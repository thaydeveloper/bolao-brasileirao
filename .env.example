# Copie para .env e preencha. NUNCA versione o .env real.

# ----- Banco de dados (Postgres) -----
# Use um Postgres público (Neon, Vercel Postgres, Supabase...).
# DATABASE_URL: string COM pooling (usada em produção/serverless).
# DIRECT_URL: string de conexão DIRETA (usada por prisma db push / migrate).
# No Neon, as duas strings estão no painel do projeto.
DATABASE_URL="postgresql://user:senha@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:senha@host/db?sslmode=require"

# ----- Segurança -----
AUTH_SECRET="gere-um-segredo-longo-e-aleatorio"
CRON_SECRET="gere-outro-segredo-para-o-cron"

# Em produção com HTTPS (Vercel), deixe "true" para o cookie de sessão ser Secure.
# Em rede local (HTTP), deixe vazio/false.
COOKIE_SECURE="true"

# ----- API de futebol (dados reais do Brasileirão) -----
# Token grátis em https://www.football-data.org/client/register
# Usado para importar rodadas/tabela e como fallback do ao vivo.
FOOTBALL_DATA_TOKEN=""

# ----- Ao vivo (placar em tempo real + minuto + gols) -----
# API-Football (api-sports.io). Chave grátis em https://dashboard.api-sports.io
# Plano grátis: 100 requisições/dia — por isso o ao vivo tem cooldown de 3 min.
# Se vazio, o ao vivo usa a football-data como fallback (sem o minuto de jogo).
API_FOOTBALL_KEY=""
